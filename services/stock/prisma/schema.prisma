generator client {
  provider = "prisma-client-js"
  // own output per service: the services share one node_modules, so the default location would collide
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String              @id @default(uuid())
  sku           String              @unique
  name          String
  quantity      Int                 @default(0)
  /// Sum of this product's Reservation rows, kept in the same transaction so one UPDATE can guard quantity - reserved
  reserved      Int                 @default(0)
  minQuantity   Int                 @default(0)
  maxQuantity   Int?
  /// Bin location R01-B03-A04-P060-N1 (Rua-Bloco-Andar-Posição-Nível); null when not shelved yet
  location      String?
  /// Sale price in cents; Live Orders reads it
  price         Int?
  /// Last purchase cost in cents
  cost          Int?
  createdAt     DateTime            @default(now())
  movements     Movement[]
  reservations  Reservation[]
  purchaseItems PurchaseOrderItem[]
}

model Movement {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  type       String // IN | OUT
  quantity   Int
  note       String?
  actorId    String?
  actorEmail String?
  createdAt  DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// One row per write. No relation to Product on purpose: a deleted product keeps its trail.
model AuditEntry {
  id         String   @id @default(uuid())
  action     String // PRODUCT_* | STOCK_* | SUPPLIER_* | PURCHASE_*
  productId  String?
  details    Json
  actorId    String
  actorEmail String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// One row per Live Orders event already applied. The primary key is what makes a repeated event harmless.
model ProcessedWebhook {
  eventSeq  String   @id
  createdAt DateTime @default(now())
}

/// Units held for an open Live Orders order. Keyed by orderId: the order number restarts every day.
model Reservation {
  orderId     String
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  orderNumber Int
  createdAt   DateTime @default(now())

  @@id([orderId, productId])
}

model Supplier {
  id        String          @id @default(uuid())
  name      String          @unique
  /// CNPJ, 14 digits without punctuation
  document  String?
  email     String?
  phone     String?
  createdAt DateTime        @default(now())
  orders    PurchaseOrder[]
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  number     Int                 @unique @default(autoincrement())
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     String // DRAFT | ORDERED | RECEIVED | CANCELLED
  createdAt  DateTime            @default(now())
  items      PurchaseOrderItem[]
}

model PurchaseOrderItem {
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  /// cents
  unitCost  Int

  @@id([orderId, productId])
}
