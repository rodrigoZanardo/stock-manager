# Same routes as nginx.conf, but the services are public Render hosts (AUTH_HOST, STOCK_HOST, REPORTS_HOST).
server {
  listen ${PORT};
  proxy_ssl_server_name on;

  location /auth/       { proxy_pass https://${AUTH_HOST}; }
  location /users       { proxy_pass https://${AUTH_HOST}; }
  location /audit/auth  { proxy_pass https://${AUTH_HOST}; }
  location /products    { proxy_pass https://${STOCK_HOST}; }
  location /movements   { proxy_pass https://${STOCK_HOST}; }
  location /audit/stock { proxy_pass https://${STOCK_HOST}; }
  location /dashboard   { proxy_pass https://${REPORTS_HOST}; }
  location /inventory   { proxy_pass https://${REPORTS_HOST}; }

  location / { return 404; }
}
