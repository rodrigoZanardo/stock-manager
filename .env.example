# Each service reads only its own section. `docker compose up` sets all of this for you;
# these values are for running a service outside Docker.
# Local JWT keys: `npm run keys` writes .keys/private.pem and .keys/public.pem (never commit them).

# --- every service (auth, stock, reports)
JWT_PUBLIC_KEY_FILE=.keys/public.pem
# Hosts without shared files (Render): put the PEM itself here instead; it wins over the _FILE variable.
# JWT_PUBLIC_KEY=
WEB_ORIGIN=http://localhost:3030
PORT=3000

# --- auth
DATABASE_URL=postgresql://app:app@localhost:5432/auth
JWT_PRIVATE_KEY_FILE=.keys/private.pem
# JWT_PRIVATE_KEY=
JWT_EXPIRES_IN=8h
# First admin, created on the first startup. Changing these later does not change an existing admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Optional read-only user (role VIEWER), created on the first startup like the admin. Leave VIEWER_EMAIL empty to skip it.
VIEWER_EMAIL=
VIEWER_PASSWORD=
# Optional public demo user (role OPERATOR: records movements, cannot manage products or users). Its password may be public. Leave DEMO_EMAIL empty to skip it.
DEMO_EMAIL=
DEMO_PASSWORD=

# --- stock: same variables as above, with its own database
# DATABASE_URL=postgresql://app:app@localhost:5432/stock
# Secret that signs the Live Orders webhook (POST /webhooks/live-orders). Unset: the route answers 503. Use the same value as the Live Orders webhook subscription.
LIVE_ORDERS_WEBHOOK_SECRET=dev-live-orders-secret

# --- reports: no database, it reads from stock
STOCK_URL=http://localhost:3033
# Optional: enables the AI inventory analysis button (admin only). Leave empty to hide it.
ANTHROPIC_API_KEY=

# --- web
API_URL=http://localhost:3031
# Session cookie over https only. Defaults to true in production; set false for a local http demo.
COOKIE_SECURE=
